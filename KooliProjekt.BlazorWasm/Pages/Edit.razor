@page "/create"
@page "/edit/{Id:int}"

@inject KooliProjekt.BlazorWasm.IApiClient apiClient
@inject NavigationManager NavManager

<h3>@title</h3>

<EditForm EditContext="editContext" OnSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p class="alert-danger">@error</p>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">ID</label>
        <div class="col-sm-10">
            @toolog.Id
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Nimi</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="toolog.Nimi"/>
            <ValidationMessage For="@(() => toolog.Nimi)" />
        </div>
    </div>

        <div class="form-group row">
        <label class="col-ms-2 col-form-label">Start Time</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="toolog.starttime" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-ms-2 col-form-label">End Time</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" @bind-Value="toolog.endtime" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Kirjeldus</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="toolog.Kirjeldus" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-ms-2 col-form-label"></label>
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Save</button>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private string error = "";
    private string title = "Edit";
    private EditContext? editContext;
    private toologi toolog = new toologi();

    private ValidationMessageStore? messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(toolog);
        messageStore = new ValidationMessageStore(editContext);

        if (Id == 0)
        {
            title = "Add";
            return;
        }

        var response = await apiClient.Get(Id);
        if (!response.HasErrors)
        {
            toolog = response.Value;
            editContext = new EditContext(toolog);
            messageStore = new ValidationMessageStore(editContext);
        }
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        messageStore?.Clear();

        var result = await apiClient.Save(toolog);
        if (!result.HasErrors)
        {
            NavManager.NavigateTo("/Toologid");
            return;
        }

        foreach (var error in result.Errors)
        {
            messageStore?.Add(new FieldIdentifier(toolog, string.Empty), error);
        }

        foreach (var error in result.PropertyErrors)
        {
            var propertyName = error.Key[0].ToString().ToUpper() + error.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(toolog, error.Key), error.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
